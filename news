<title>News Graphic Generator</title>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap" rel="stylesheet">

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: #f4f6f8;
    text-align: center;
    padding: 20px;
    font-family: Arial;
  }

  h1 {
    color: #006163;
    margin-bottom: 15px;
  }

  #newsCanvasContainer {
    width: 1080px;
    height: 1350px;
    margin: auto;
    border: 1px solid #ccc;
    background: #fff;
    position: relative;
  }

  canvas {
    display: block;
  }

  input, select, button {
    padding: 10px;
    margin: 6px;
    font-size: 16px;
  }

  #headlineInput {
    width: 80%;
    font-family: Montserrat;
    font-weight: 700;
  }
</style>
